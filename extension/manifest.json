{
  "manifest_version": 3,
  "name": "Speech Clock Dub",
  "version": "0.7.3",
  "description": "Dubs YouTube lecture videos into Japanese, English, Chinese or Korean. The video follows the voice, not the other way around.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://texttospeech.googleapis.com/*", "https://generativelanguage.googleapis.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "scripts": ["defaults.js", "background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "speech-clock-dub@nexplico-ltd.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["defaults.js", "asr.js", "speakers.js", "subtitle.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
