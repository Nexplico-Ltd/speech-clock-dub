{
  "manifest_version": 3,
  "name": "Speech Clock Dub",
  "version": "0.5.2",
  "description": "Dubs YouTube lecture videos into Japanese, English, Chinese or Korean. The video follows the voice, not the other way around.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://texttospeech.googleapis.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["defaults.js", "asr.js", "speakers.js", "subtitle.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
